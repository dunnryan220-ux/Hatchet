generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  OWNER
  CLIENT
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                  String               @id @default(cuid())
  name                String?
  email               String               @unique
  emailVerified       DateTime?
  image               String?
  hashedPassword      String?
  role                Role                 @default(CLIENT)
  agencyId            String
  agency              Agency               @relation(fields: [agencyId], references: [id])
  clientAccess        ClientAccess[]
  accounts            Account[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  createdAt           DateTime             @default(now())
}

model Agency {
  id           String   @id @default(cuid())
  name         String
  logo         String?
  primaryColor String   @default("#FF4500")
  users        User[]
  clients      Client[]
  createdAt    DateTime @default(now())
}

model Client {
  id                  String           @id @default(cuid())
  agencyId            String
  agency              Agency           @relation(fields: [agencyId], references: [id])
  name                String
  website             String?
  googleAdsCustomerId String?
  ga4PropertyId       String?
  gbpLocationId       String?
  gbpRefreshToken     String?
  fbAdAccountId       String?
  fbAccessToken       String?
  fbTokenExpiresAt    DateTime?
  fbPageId            String?
  igAccountId         String?
  budgets             Budget[]
  keywords            TrackedKeyword[]
  spendHistory        SpendHistory[]
  clientAccess        ClientAccess[]
  reportSchedules     ReportSchedule[]
  createdAt           DateTime         @default(now())
}

model ClientAccess {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  grantedBy String
  grantedAt DateTime @default(now())
}

model Budget {
  id          String          @id @default(cuid())
  clientId    String
  client      Client          @relation(fields: [clientId], references: [id])
  channel     String
  amount      Float
  period      String
  spentAmount Float           @default(0)
  history     BudgetHistory[]
  createdAt   DateTime        @default(now())
}

model BudgetHistory {
  id        String   @id @default(cuid())
  budgetId  String
  budget    Budget   @relation(fields: [budgetId], references: [id])
  changedBy String
  oldAmount Float
  newAmount Float
  changedAt DateTime @default(now())
}

model TrackedKeyword {
  id           String        @id @default(cuid())
  clientId     String
  client       Client        @relation(fields: [clientId], references: [id])
  keyword      String
  targetUrl    String
  currentRank  Int?
  previousRank Int?
  group        String?
  rankHistory  RankHistory[]
  updatedAt    DateTime      @updatedAt
}

model RankHistory {
  id               String         @id @default(cuid())
  trackedKeywordId String
  keyword          TrackedKeyword @relation(fields: [trackedKeywordId], references: [id])
  rank             Int
  recordedAt       DateTime       @default(now())
}

model SpendHistory {
  id       String   @id @default(cuid())
  clientId String
  client   Client   @relation(fields: [clientId], references: [id])
  channel  String
  spend    Float
  date     DateTime
}

model ReportSchedule {
  id         String    @id @default(cuid())
  clientId   String
  client     Client    @relation(fields: [clientId], references: [id])
  frequency  String
  recipients String  @default("[]")
  enabled    Boolean   @default(true)
  lastSentAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}
